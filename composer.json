{
    "name": "pandu/gauss",
    "description": "A precise and composable mathematical toolkit for PHP, built from reusable mathematical primitives for constructing reliable mathematical models.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Pandu"
        }
    ],
    "keywords": [
        "php",
        "mathematics",
        "numerical-analysis",
        "statistics",
        "probability",
        "linear-algebra",
        "optimization",
        "time-series"
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Gauss\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gauss\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}